# One .gitignore for the whole repo (web/, sdk/js/, sdk/python/).

# Dependencies
node_modules/
.venv/

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts
__pycache__/
*.py[cod]
*.egg-info/

# Env / secrets (commit .env.example with fake values only)
.env
.env.*
!.env.example

# Logs
*.log

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
