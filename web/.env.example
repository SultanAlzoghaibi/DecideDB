# Copy to web/.env.local and fill in. Never commit real values.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://jevdb:jevdb@localhost:5433/jevdb

# Better Auth. Secret signs session cookies: generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Optional OAuth logins. Leave blank to hide the button.
# Callback URL: http://localhost:3000/api/auth/callback/github (or /google)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (sign-up verification codes) via https://resend.com. Blank in dev = codes print in the terminal.
# Until you verify a domain in Resend, keep the onboarding@resend.dev sender; it only delivers to your own email.
RESEND_API_KEY=
EMAIL_FROM=DecisionDB <onboarding@resend.dev>
