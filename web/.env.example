# Copy to web/.env.local and fill in. Never commit real values.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://jevdb:jevdb@localhost:5433/jevdb

# Better Auth. Secret signs session cookies: generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Optional OAuth logins. Leave blank to hide the button.
# Callback URL: http://localhost:3000/api/auth/callback/github (or /google)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
